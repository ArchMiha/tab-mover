{
  "manifest_version": 3,
  "name": "Tab Mover to Isolated Instance",
  "version": "1.0.0",
  "description": "Move the active tab to a new isolated Chromium instance with persistent profile",

  "permissions": [
    "tabs",
    "activeTab",
    "nativeMessaging",
    "notifications"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "commands": {
    "move-tab-to-instance": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "linux": "Ctrl+Shift+G"
      },
      "description": "Move active tab to new Chromium instance"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Move tab to new window (Ctrl+Shift+G)"
  }
}
